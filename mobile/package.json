  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:update:preview": "eas update --branch preview --message \"Atualizacao preview\"",
    "eas:update:production": "eas update --branch production --message \"Atualizacao producao\"",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:production:android": "eas build --profile production --platform android"
  },
  "dependencies": {
