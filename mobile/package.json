    "expo": "^57.0.0",
    "expo-camera": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-mask-input": "^1.2.3",
