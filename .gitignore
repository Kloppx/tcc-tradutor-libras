# --- Python & Ambiente ---
__pycache__/
*.pyc
.env
venv/
*.egg-info/

# --- IDEs ---
.vscode/
.idea/

# --- DADOS (Onde moram os vídeos) ---
# Garante que qualquer nome comum de pasta de dados seja ignorado
data/
dataset/
datasets/
videos/

# --- ARQUIVOS DE MÍDIA (Segurança Extra) ---
# Caso você deixe um vídeo solto na raiz sem querer
*.mp4
*.avi
*.mov
*.mkv

# --- MODELOS DE IA (Pesos Treinados - MUITO IMPORTANTE) ---
# Estes arquivos são pesados e gerados pelo treino
*.h5
*.hdf5
*.pt
*.pth
*.keras
*.onnx
!/models/modelo_final.h5

# O modelo usado pela API faz parte do pacote executavel do projeto.
!models/melhor_modelo_v2.keras

# --- DADOS PROCESSADOS (MediaPipe) ---
# Ignora numpy arrays salvos, mas permite CSV/JSON se você quiser
# (Se quiser bloquear todos CSVs, mantenha o *.csv que você tinha)
*.npy
*.npz

# --- SEGREDOS ---
credentials/

# Vídeos de acessibilidade usados diretamente pelo aplicativo mobile
!mobile/assets/videos/
!mobile/assets/videos/**

# --- ARQUIVOS LOCAIS E TEMPORÁRIOS ---
.tmp/
scratch/
*.log
err.txt
out.txt
~$*.docx
~$*.pptx

# Versoes intermediarias locais da apresentacao.
APRESENTACAO_REGISTRO_INTERPRETARTE_v4.pptx
output/
